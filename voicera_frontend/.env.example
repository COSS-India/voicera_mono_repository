# Voice server — Vobiz/Plivo answer URLs and Test on Browser (http→ws, https→wss)
NEXT_PUBLIC_JOHNAIC_SERVER_URL=https://your-public-voice-host

# Server-side reach to the voice server from Next.js route handlers (outbound
# calls, GPU telemetry). Optional — defaults to NEXT_PUBLIC_JOHNAIC_SERVER_URL,
# then http://localhost:7860. Set this when the frontend runs in a container:
# VOICE_SERVER_URL=http://voice_server:7860