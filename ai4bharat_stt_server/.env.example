# ============================================
# AI4Bharat STT Server Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# === Required: model checkpoints ===
# Main Indic NeMo checkpoint FILE path (not a HuggingFace model id).
# Relative paths resolve against ai4bharat_stt_server/. In Docker the models
# directory is mounted read-only at /app/models.
INDIC_NEMO_PATH=/app/models/indic-conformer.nemo

# === Bhili (bhb) checkpoint ===
# BHILI_ENABLE=yes loads a second model and enables POST /transcribe/bhili.
# BHILI_NEMO_PATH is required only when BHILI_ENABLE=yes.
BHILI_ENABLE=no
# BHILI_NEMO_PATH=/app/models/bhili.nemo

# === HuggingFace Token (Optional) ===
# Required if the model is gated on HuggingFace
HF_TOKEN=your-huggingface-token

# === Server Configuration ===
# Port to run the server on (default: 8001)
PORT=8001
# uvicorn worker processes. NOTE: each worker loads its OWN copy of the model
# and runs its OWN batcher, so N workers divide batching efficiency by N.
# See SCALABILITY_OPS_ISSUES.md (S3) before raising this.
STT_NUM_WORKERS=4

# === Batching / capacity (all optional, shown with defaults) ===
# STT_MAX_BATCH_SIZE=16
# STT_BATCH_TIMEOUT_MS=100
# STT_QUEUE_MAXSIZE=256
# Longest single request accepted; larger payloads get 413.
# STT_MAX_AUDIO_SECONDS=60
# Queued requests older than this are dropped un-inferred (matches the voice
# server's 10 s client timeout) so overload sheds instead of amplifying.
# STT_REQUEST_DEADLINE_S=10
# Extra grace before the handler gives up and returns 504.
# STT_RESPONSE_GRACE_S=5

# === Health / observability (optional) ===
# /health reports "degraded" + 503 if a worker heartbeat is older than this.
# STT_WORKER_STALL_SECONDS=60
# Idle seconds before releasing cached CUDA memory back to the driver.
# STT_IDLE_EMPTY_CACHE_SECONDS=60
# Rolled-up throughput/RTFx log line every N batches (0 disables).
# STT_LOG_SUMMARY_EVERY=100

# === Performance (optional) ===
# TF32 matmuls on Ampere+. Set to "highest" to force strict fp32.
# STT_MATMUL_PRECISION=high
