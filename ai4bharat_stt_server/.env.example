# ============================================
# AI4Bharat STT Server Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# === HuggingFace Token (Optional) ===
# Required if the model is gated on HuggingFace
HF_TOKEN=your-huggingface-token

# === Server Configuration ===
# Port to run the server on (default: 8001)
# Can also be set via --port argument
PORT=8001

# === Experimental automatic-language shadow mode ===
# Keep disabled in production until explicitly running the observation trial.
# When enabled, the benchmarked HF IndicConformer is loaded alongside the
# production NeMo model; a shadow failure never changes explicit-language ASR.
ENABLE_AUTO_LANGUAGE_SHADOW=false
AUTO_LANGUAGE_MIN_DURATION_MS=2000
AUTO_LANGUAGE_SHADOW_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual

# Controlled LIVE experiment. CUDA and CUDAExecutionProvider are mandatory.
ENABLE_AUTO_LANGUAGE=false
AUTO_LANGUAGE_DEVICE=cuda
AUTO_LANGUAGE_CANDIDATE_LANGUAGES=hi,kn,mr,ta,te
