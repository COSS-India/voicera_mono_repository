# Indic-Mio TTS server config. Copy to .env; all keys are optional (defaults in config.py).

# vLLM OpenAI-compatible backend (MUST include the /v1 suffix).
INDIC_MIO_VLLM_URL=http://vllm-mio:8100/v1
MIO_LLM_MODEL=SPRINGLab/Indic-Mio

# WebSocket front
MIO_HOST=0.0.0.0
MIO_PORT=8003

# MioCodec (decodes content tokens -> waveform), colocated on the vLLM GPU.
MIO_CODEC_MODEL_ID=Aratako/MioCodec-25Hz-24kHz
MIO_DEVICE=cuda

# Generation (SPRINGLab card defaults)
MIO_TEMPERATURE=0.9
MIO_TOP_P=0.9
MIO_MAX_TOKENS=1024

# Bound concurrent GPU decodes (vLLM already batches token-gen).
MIO_DECODE_CONCURRENCY=2

# Streaming decode (low time-to-first-byte). Set false for a single whole-utterance
# decode (highest quality safety, higher latency) if flush-boundary artifacts appear.
MIO_STREAM_DECODE=true
MIO_FLUSH_TOKENS=32
MIO_LOOKAHEAD_TOKENS=6
