# Mongo-compatible DB via FerretDB (PostgreSQL + DocumentDB under the hood).
# In Docker Compose use MONGODB_HOST=mongodb (network alias for ferretdb).
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_PASSWORD=admin123
MONGODB_DATABASE=voicera
# Leave empty for FerretDB. Use "admin" only against legacy MongoDB.
MONGODB_AUTH_SOURCE=
# Optional: SCRAM-SHA-256 (FerretDB) — usually omit and let the driver negotiate
# MONGODB_AUTH_MECHANISM=SCRAM-SHA-256

# Application Configuration
DEBUG=False

# Security Configuration
SECRET_KEY=secret_key

# Mailtrap Configuration
MAILTRAP_API_TOKEN=your-mailtrap-api-token-here
MAILTRAP_FROM_EMAIL=noreply@voicera.com
MAILTRAP_FROM_NAME=Voicera
FRONTEND_URL=http://localhost:3000

# Internal API Key for service-to-service communication (bot -> backend)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=your-internal-api-key-here

# Default (demo) agents: seed pre-configured agents per org. Set false to stop
# all seeding/backfill (existing seeded agents are left untouched).
DEMO_AGENTS_ENABLED=True

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional: override Chroma persistence root (default: voicera_backend/rag_system/chroma_data)
# CHROMA_BASE_DIR=/path/to/chroma_data

# Vobiz API Configuration
VOBIZ_API_BASE_URL=your-vobiz-base-url
VOBIZ_ACCOUNT_ID=your-vobiz-account-id
VOBIZ_AUTH_ID=your-vobiz-auth-id
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token

# Knowledge base embeddings: platform OpenAI key used when an org has no OpenAI
# integration. Gated by ALLOW_PLATFORM_KEY_FALLBACK (default true; set false to disable).
OPENAI_API_KEY=your-platform-openai-key-here
ALLOW_PLATFORM_KEY_FALLBACK=true
