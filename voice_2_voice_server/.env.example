# ============================================
# Voice Server Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# === Vobiz Telephony API ===
VOBIZ_AUTH_ID=your-vobiz-auth-id
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token
VOBIZ_API_BASE=https://api.vobiz.in/v1
VOBIZ_CALLER_ID=+91XXXXXXXXXX

# === Plivo Telephony API ===
# Runtime credentials should come from backend Integrations (PlivoAuthId / PlivoAuthToken).
# Keep these as optional placeholders for local reference only.
PLIVO_AUTH_ID=your-plivo-auth-id
PLIVO_AUTH_TOKEN=your-plivo-auth-token
PLIVO_API_BASE=https://api.plivo.com/v1
PLIVO_CALLER_ID=+91XXXXXXXXXX

# === Server URLs ===
# Public URL where this server is accessible (for Vobiz callbacks and VI post-stream API)
JOHNAIC_SERVER_URL=https://your-server-domain.com
# WebSocket URL prefix for audio streaming (Vobiz, Plivo, VI, browser test)
JOHNAIC_WEBSOCKET_URL=wss://your-server-domain.com
# VI uses: {JOHNAIC_WEBSOCKET_URL}/vi/agent/{agent_id}  (must not be a .ai domain)

# === Vodafone Idea (VI) Voice Streaming ===
# Inbound: configure VI portal once with WSS URL {JOHNAIC_WEBSOCKET_URL}/vi/stream
# Recording webhook (flow-builder ApiCall after HangUp): {JOHNAIC_SERVER_URL}/vi/recording-webhook
# Route agents by DNI attached on the Numbers page (see docs/guides/vi-multi-agent-routing.md)
# VI_DEFAULT_AGENT_ID=

# === Vodafone Idea (VI) OBD Outbound Campaign API ===
VI_OBD_USERNAME=
VI_OBD_PASSWORD=
VI_DNI=
# Optional: override default flow ID and dial timeout
# VI_FLOW_ID=Or5NHOa3hND98TLJ/1pyCQ==
# VI_OBD_DIAL_TIMEOUT=30
# Optional: override OBD API base (must include /Cpaas/api/v1/)
# VI_OBD_BASE_URL=https://cts.myvi.in:8443/Cpaas/api/v1/obdcampaignapi

# === Backend API ===
VOICERA_BACKEND_URL=http://localhost:8000
# Internal API key for secure service-to-service communication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=your-internal-api-key-here

# === MinIO Storage ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# === Bhashini STT API ===
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_SOCKET_URL=your-bhasini-wss-url

# === Bhashini Bhili STT (NVCF Triton gRPC) ===
# Required when agent language is bhb and STT provider is bhashini
BHASHINI_BHILI_STT_FUNCTION_ID=your-nvcf-function-uuid
BHASHINI_BHILI_STT_AUTH_TOKEN=your-nvapi-key
# Optional overrides (defaults shown)
# BHASHINI_BHILI_STT_GRPC_URL=grpc.nvcf.nvidia.com:443
# BHASHINI_BHILI_STT_FUNCTION_VERSION_ID=

# === External TTS/STT Services (if using local AI4Bharat servers) ===
AI4BHARAT_STT_URL=http://localhost:8001
INDIC_STT_SERVER_URL=http://localhost:8001
AI4BHARAT_TTS_URL=http://localhost:8002

# === Experimental AI4Bharat automatic-language shadow mode ===
# Disabled by default. These settings only observe final VAD utterances and
# never change the configured STT language or transcript.
ENABLE_AUTO_LANGUAGE_SHADOW=false
AUTO_LANGUAGE_MIN_DURATION_MS=2000
AUTO_LANGUAGE_MAX_DURATION_MS=3000
# Preliminary threshold calibrated on hi,kn,mr,ta,te; not production-final.
AUTO_LANGUAGE_MARGIN_THRESHOLD=0.050965
AUTO_LANGUAGE_CANDIDATE_LANGUAGES=hi,kn,mr,ta,te

# Controlled LIVE experiment. Keep false unless explicitly testing automatic
# switching. Requires the STT server's GPU live mode to initialize successfully.
ENABLE_AUTO_LANGUAGE=false
# Set to "auto" to ignore agent/frontend STT language and bootstrap from the
# first utterance probe. Agent language is kept as probe-failure fallback only.
AUTO_LANGUAGE_STT_LANGUAGE=
AUTO_LANGUAGE_DEVICE=cuda
AUTO_LANGUAGE_CONFIRMATION_COUNT=2
AUTO_LANGUAGE_REPROBE_COOLDOWN_MS=1500
AUTO_LANGUAGE_EVENT_LOG_PATH=logs/auto_language_events.jsonl

# === Kenpath / Vistaar LLM ===
KENPATH_JWT_PRIVATE_KEY_PATH=services/kenpath_llm/jwt_private_key.pem
# KENPATH_JWT_PHONE=+91-9036722772
# KENPATH_VISTAAR_API_URL_PROD=https://voice-prod.mahapocra.gov.in
# KENPATH_VISTAAR_API_URL_DEV=https://vistaar-dev.mahapocra.gov.in
# KENPATH_VOICE_BHILI_URL=https://vistaar-dev.mahapocra.gov.in/api/voice-bhili

# === Bharat Vistaar LLM (Kenpath backend: bharatvistaar) ===
# Place prod_private_key_bh.pem in services/kenpath_llm/
BHARAT_VISTAAR_JWT_PRIVATE_KEY_PATH=services/kenpath_llm/prod_private_key_bh.pem
# BHARAT_VISTAAR_API_URL=https://chat-vistaar.da.gov.in
