# ============================================
# Voice Server Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# === Vobiz Telephony API ===
VOBIZ_AUTH_ID=your-vobiz-auth-id
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token
VOBIZ_API_BASE=https://api.vobiz.in/v1
VOBIZ_CALLER_ID=+91XXXXXXXXXX

# === Platform key fallback (kill-switch) ===
# When true, ANY agent whose org has no Integrations credentials may fall back
# to this file's OPENAI_API_KEY and VOBIZ_AUTH_ID/VOBIZ_AUTH_TOKEN. Set to
# false to disable platform-key fallback instantly for all agents/orgs.
ALLOW_PLATFORM_KEY_FALLBACK=true
# Optional: pin the OpenAI model used when an agent falls back to the platform
# key. If set, that model is forced regardless of the agent's configured model.
# Leave empty to let agents choose any model on the platform key.
PLATFORM_OPENAI_MODEL=

# === Plivo Telephony API ===
# Runtime credentials should come from backend Integrations (PlivoAuthId / PlivoAuthToken).
# Keep these as optional placeholders for local reference only.
PLIVO_AUTH_ID=your-plivo-auth-id
PLIVO_AUTH_TOKEN=your-plivo-auth-token
PLIVO_API_BASE=https://api.plivo.com/v1
PLIVO_CALLER_ID=+91XXXXXXXXXX

# === Server URLs ===
# Public URL where this server is accessible (for Vobiz callbacks)
JOHNAIC_SERVER_URL=https://your-server-domain.com
# WebSocket URL prefix for audio streaming
JOHNAIC_WEBSOCKET_URL=wss://your-server-domain.com

# === Backend API ===
VOICERA_BACKEND_URL=http://localhost:8000
# Internal API key for secure service-to-service communication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=your-internal-api-key-here

# === MinIO Storage ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# === Bhashini STT API ===
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_SOCKET_URL=your-bhasini-wss-url

# === Bhashini Bhili STT (NVCF Triton gRPC) ===
# Required when agent language is bhb and STT provider is bhashini
BHASHINI_BHILI_STT_FUNCTION_ID=your-nvcf-function-uuid
BHASHINI_BHILI_STT_AUTH_TOKEN=your-nvapi-key
# Optional overrides (defaults shown)
# BHASHINI_BHILI_STT_GRPC_URL=grpc.nvcf.nvidia.com:443
# BHASHINI_BHILI_STT_FUNCTION_VERSION_ID=

# === External TTS/STT Services (if using local AI4Bharat servers) ===
AI4BHARAT_STT_URL=http://localhost:8001
AI4BHARAT_TTS_URL=http://localhost:8002
# INDIC_TTS_SERVER_URL=ws://localhost:8002
# INDIC_TTS_GAIN=1.5
# Give up on a stalled Parler server after this long without an audio frame.
# INDIC_TTS_SOCK_READ_SECS=30

# === Live translation (per-segment tuning; defaults shown) ===
# Silence before VAD ends the presenter's utterance and the pipeline fires.
# TRANSLATION_VAD_STOP_SECS=0.4
# LLM engine only (agent_config.translation_engine = "llm", the default):
# TRANSLATION_MODEL=gpt-4o-mini
# Inactivity limits, not total-duration limits: a stalled provider must not hold
# a target language silent for the rest of the broadcast.
# TRANSLATION_LLM_TIMEOUT_SECS=10
# TRANSLATION_TTS_STALL_SECS=20
# TRANSLATION_PRESENTER_GRACE_SECS=20
# TRANSLATION_SESSION_TIMEOUT_SECS=3600

# --- NMT translation engine (agent_config.translation_engine = "nmt") ---
# Hosted AI4Bharat IndicTrans2 on Triton. REQUIRED for the nmt engine; unset for
# an LLM-only deployment. An nmt-only deployment needs no OpenAI key. The host is
# private — set it only in your real (gitignored) .env, never commit the address.
# NMT_SERVER_URL=http://<nmt-host>:8000     # Triton root (no trailing /v2/...)
# NMT_MODEL_NAME=nmt
# Client-side coalescing window (ms): every room's languages that arrive within
# it leave as ONE Triton request. Widen (20-30) before adding in-flight requests.
# NMT_BATCH_WINDOW_MS=8
# NMT_MAX_BATCH=64             # rows per request; server cap is 512
# NMT_MAX_INFLIGHT=4           # concurrent requests behind one GPU instance
# NMT_TIMEOUT_SECS=8           # per-request read deadline (measured p100 ~0.45 s)
# NMT_MAX_QUEUE=2048           # rows waiting to batch; overflow fails the segment fast
# NMT_MAX_SEGMENT_CHARS=1200   # above this, split at sentence bounds into same-batch rows

# === Kenpath / Vistaar LLM ===
KENPATH_JWT_PRIVATE_KEY_PATH=services/kenpath_llm/jwt_private_key.pem
# KENPATH_JWT_PHONE=+91-9036722772
# KENPATH_VISTAAR_API_URL_PROD=https://voice-prod.mahapocra.gov.in
# KENPATH_VISTAAR_API_URL_DEV=https://vistaar-dev.mahapocra.gov.in
# KENPATH_VOICE_BHILI_URL=https://vistaar-dev.mahapocra.gov.in/api/voice-bhili

# === Bharat Vistaar LLM (Kenpath backend: bharatvistaar) ===
# Place prod_private_key_bh.pem in services/kenpath_llm/
BHARAT_VISTAAR_JWT_PRIVATE_KEY_PATH=services/kenpath_llm/prod_private_key_bh.pem
# BHARAT_VISTAAR_API_URL=https://chat-vistaar.da.gov.in
