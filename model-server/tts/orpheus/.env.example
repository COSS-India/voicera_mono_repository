# Copy to .env and edit.
#
# docker-compose.yml passes this whole file into the container via `env_file:`,
# so every variable below takes effect and overrides the matching key in
# config.yaml. config.yaml documents what each one does; this file is just the
# place to set them for a deployment.
#
# The boot log prints an `env overrides:` line listing exactly which variables
# were applied. Check it if a setting appears not to take effect.

# --- capacity -----------------------------------------------------------------
# Concurrent-stream admission limit. An ADMISSION policy, not a throughput knob.
# 256 admits everything (right for buffered/batch clients); 64 keeps a bursty
# live workload smooth; 32 holds up under sustained live load. Measurements are
# in config.yaml.
ORPHEUS_MAX_NUM_SEQS=256

# Fraction of GPU memory vLLM reserves for weights plus KV cache. Up to ~0.95 on
# a dedicated card; lower it if the GPU is shared.
ORPHEUS_GPU_MEMORY_UTILIZATION=0.90

# 'fp8' needs compute capability >= 8.9 (Ada/Hopper/Blackwell). Use 'none' below that.
ORPHEUS_QUANTIZATION=fp8

# Keep at or above ORPHEUS_MAX_NUM_SEQS, or SNAC decode competes with generation.
# ORPHEUS_DECODER_MAX_BATCH=256

# --- model --------------------------------------------------------------------
# Path inside the container. ./models is bind-mounted to /models by compose.
ORPHEUS_MODEL_PATH=/models/orpheus-indic-5679
# ORPHEUS_DTYPE=auto
# ORPHEUS_MAX_MODEL_LEN=8192
# ORPHEUS_MAX_TOKENS_DEFAULT=8192
# ORPHEUS_MAX_TOKENS_LIMIT=8192
# ORPHEUS_TRUST_REMOTE_CODE=false

# --- server -------------------------------------------------------------------
# Host port compose publishes. The container always listens on 9000 internally.
ORPHEUS_PORT=9000
ORPHEUS_LOG_LEVEL=INFO

# Seconds in-flight streams get to finish on shutdown. docker-compose.yml's
# stop_grace_period (60s) must stay above this.
# ORPHEUS_DRAIN_TIMEOUT=30

# ORPHEUS_MODEL_NAME=orpheus-indic
# ORPHEUS_CORS_ORIGINS=*
# ORPHEUS_VOICES_FILE=voices.json

# --- warmup -------------------------------------------------------------------
# Widths should reach ORPHEUS_MAX_NUM_SEQS. Trimming the tail cuts boot time and
# moves the JIT cost onto the first burst of real traffic at that width.
# ORPHEUS_WARMUP_ENABLED=true
# ORPHEUS_WARMUP_WIDTHS=1,2,4,8,16,32,64,128,256
# ORPHEUS_WARMUP_MAX_TOKENS=64

# --- engine / decoder ---------------------------------------------------------
# ORPHEUS_ENFORCE_EAGER=false
# ORPHEUS_TENSOR_PARALLEL_SIZE=1
# ORPHEUS_DECODER_DEVICE=cuda
# ORPHEUS_SNAC_MODEL_ID=hubertsiuzdak/snac_24khz

# --- sampling -----------------------------------------------------------------
# Stack-verified for Orpheus. Changing these degrades audio quality.
# ORPHEUS_TEMPERATURE=0.6
# ORPHEUS_TOP_P=0.8
# ORPHEUS_REPETITION_PENALTY=1.3
# ORPHEUS_MIN_TOKENS=28

# --- logging ------------------------------------------------------------------
# INFO shows vLLM's KV-cache accounting at boot, which is how you see the real
# effect of a quantization or gpu_memory_utilization change.
# VLLM_LOGGING_LEVEL=INFO
