# ============================================================
# model-server — copy to .env
# ============================================================

# Which slots run. These are slot names, not model names: the profile answers
# "is this slot on", the *_MODEL below answers "which model fills it".
COMPOSE_PROFILES=stt,tts

# Which model fills each slot. The value is a folder name under stt/, tts/ or
# llm/ -- so switching model is editing one line here and rebuilding that one
# service. `docker compose ... up -d --build llm`
#
# The gateway reads these too: a slot counts as deployed when its model is
# named, so Compose and the gateway cannot disagree about what is running.
STT_MODEL=indic-conformer
TTS_MODEL=indic-parler
LLM_MODEL=

# GPU. GPU 1 is our team's allocation on ace-h200. It runs in Exclusive Process
# mode behind an MPS daemon, shared with the prod TTS workers -- so our
# containers must attach as MPS clients, not claim the device directly.
# ~80GB of 143GB free as of 26 Aug; STT and TTS together need roughly 12GB.
GPU_DEVICE_IDS=1

# The only published port. Model containers bind nothing on the host.
GATEWAY_PORT=8100

# MPS. Leave these commented unless the daemon lives somewhere unusual --
# setup.sh detects whether one is running and writes the real paths in.
#
# A GPU in Exclusive Process mode can only be shared through an MPS daemon; a
# GPU in the ordinary Default mode needs none of this and setup.sh will say so
# and carry on. The convention here is one pipe directory per GPU, so the
# default follows GPU_DEVICE_IDS above. Set these explicitly when the daemon is
# elsewhere, or when GPU_DEVICE_IDS names more than one device and "gpu<N>"
# stops meaning anything.
#   nvidia-smi -q | grep -i "compute mode"
# MPS_PIPE_DIR=/tmp/nvidia-mps-gpu1
# MPS_LOG_DIR=/tmp/nvidia-mps-log-gpu1

# Upstreams default to the Compose service names, which never change when you
# swap a model. Uncomment only to point a slot at a different host entirely.
# STT_UPSTREAM=http://stt:8001
# TTS_UPSTREAM=http://tts:8002
# LLM_UPSTREAM=http://llm:8003

# Weights. Paths are inside the container; the host side comes from the bind
# mount of the model's own folder, where setup.sh downloads them.
INDIC_NEMO_PATH=/app/models/IndicConformer.nemo
BHILI_ENABLE=no
BHILI_NEMO_PATH=

# The Parler tokenizer lives in a gated HuggingFace repo. Simplest path is to
# read an existing cache that already has it -- add the overlay:
#   docker compose -f compose.model-server.yml -f compose.shared-hf-cache.yml ...
# Otherwise supply a token with access to ai4bharat/indic-parler-tts.
HF_CACHE_VOLUME=voicera-prod_hf_cache
HF_TOKEN=

# 0 lets a container fetch from HuggingFace on first start, which is what the
# vLLM-backed models rely on. Set to 1 only when pointing at a cache that
# already holds everything -- offline mode turns a gated 401 into a clean miss.
# A model whose image cannot fetch at all pins this itself; see below.
HF_HUB_OFFLINE=0

# vLLM runtime limits, applied to whichever model fills the LLM slot. Which
# model and which model-specific flags live in llm/<model>/Dockerfile, not here.
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=20
# Never vLLM's 0.9 default: this GPU is shared through MPS, which does not
# partition memory, so a greedy pre-allocation would starve the prod workers.
VLLM_GPU_MEMORY_UTILIZATION=0.10
# Empty means bf16. Set to fp8 only if memory becomes the constraint.
VLLM_QUANTIZATION=

# ---- Per-model settings -------------------------------------------------
# Only read when that model fills its slot, and only when the model's own
# compose.extra.yml is layered in -- setup.sh does that automatically. Listed
# here so the variables are discoverable rather than buried in an overlay.

# stt/indic-transcribe. Its image is built with HF_HUB_OFFLINE=1 baked in and
# cannot fetch anything, so both paths must exist on the host before it starts;
# see stt/indic-transcribe/README.md for how they are produced. Defaults sit
# beside the model folder and are gitignored.
# CORE_MODELS_DIR=./stt/indic-transcribe/models/core
# CORE_ARTIFACTS_DIR=./stt/indic-transcribe/artifacts
# CORE_LANGUAGE=hi

# tts/indic-mio. It delegates token generation to a vLLM sidecar the folder
# brings with it, so this is a second reservation on the same card as
# VLLM_GPU_MEMORY_UTILIZATION above -- not an alternative to it. Upstream's
# 0.35 would take ~50GB of a 143GB H200, on a GPU shared with prod.
# MIO_VLLM_GPU_MEMORY_UTILIZATION=0.06
# INDIC_MIO_VLLM_URL=http://vllm-mio:8100/v1

# ---- Build contexts -----------------------------------------------------
# Local checkout of the AI4Bharat NeMo fork. Relative paths resolve against
# this directory, not the model folder. Cloning it inside the image costs an
# extra ~8GB and a long compile; prod passes it in as a build context, so do we.
#   git clone --branch nemo-v2 --depth 1 https://github.com/AI4Bharat/NeMo.git ~/ai4bharat_nemo
NEMO_CONTEXT_PATH=../../ai4bharat_nemo
