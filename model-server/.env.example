# ============================================================
# model-server — copy to .env
# ============================================================

# Which model fills each slot. Compose starts only these services.
STT_MODEL=indic-conformer
TTS_MODEL=indic-parler
LLM_MODEL=
COMPOSE_PROFILES=${STT_MODEL},${TTS_MODEL},${LLM_MODEL}

# GPU. GPU 1 is our team's allocation on ace-h200. It runs in Exclusive Process
# mode behind an MPS daemon, shared with the prod TTS workers -- so our
# containers must attach as MPS clients, not claim the device directly.
# ~80GB of 143GB free as of 26 Aug; our two models need roughly 12GB.
GPU_DEVICE_IDS=1

# The only published port. Model containers bind nothing on the host.
GATEWAY_PORT=8100

# Model ports. Still published so the old direct-to-model path keeps working
# during cutover. Once the gateway is verified, delete the `ports:` blocks for
# stt/tts/llm in compose and these become irrelevant.
STT_PORT=8001
TTS_PORT=8002
LLM_PORT=8003

# Upstreams are derived from the model names above and default to the compose
# service names. Uncomment only to point a slot at a different host.
# STT_UPSTREAM=http://stt:8001
# TTS_UPSTREAM=ws://tts:8002
# LLM_UPSTREAM=http://llm:8003

# Weights. Paths are inside the container; the host side comes from the bind
# mounts, where setup.sh already downloads them.
INDIC_NEMO_PATH=/app/models/IndicConformer.nemo
BHILI_ENABLE=no
BHILI_NEMO_PATH=

HF_TOKEN=

# vLLM (only when the LLM slot is enabled)
LLM_MODEL_ID=Qwen/Qwen3-8B
VLLM_QUANTIZATION=fp8
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=20
VLLM_GPU_MEMORY_UTILIZATION=0.30

# Pin the AI4Bharat NeMo fork; the exp_manager patches are line-matched.
NEMO_REF=nemo-v2
